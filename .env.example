# At least one provider key is required for the cloud LLM path.
# Get a free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternatives (supported by code, not required for HW1 / HW2 local path)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: HW2 Step 1 corpus & chunking overrides (100% local, zero API keys)
HW2_CORPUS_RAW_DIR=data/hw2_corpus/raw
HW2_CORPUS_OUT_DIR=data/hw2_corpus
HW2_CHUNK_MAX_TOKENS=360
HW2_CHUNK_OVERLAP_TOKENS=45

# Optional: HW2 Step 2 Qdrant index, multilingual ONNX embeddings & reranker ($0/1000 queries)
HW2_QDRANT_PATH=data/hw2_index/qdrant
HW2_QDRANT_COLLECTION=hw2_analytics_chunks
HW2_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HW2_RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# Optional: HW2 Step 3–4 Grounded RAG, context budget & calibrated judge
HW2_RAG_PROMPT_VERSION=v2
HW2_MAX_CONTEXT_TOKENS=1200
HW2_RAG_MODEL=gemini-3.5-flash-lite
HW2_JUDGE_MODEL=gemini-3.5-flash-lite

# Optional: re-export tickets from Jira
JIRA_URL=https://nlamonova.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BUGS
